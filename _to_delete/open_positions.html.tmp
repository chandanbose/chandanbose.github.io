   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
   <style id="op-styles">
      .op-page { --op-accent: #e5533d; --op-green: #2e7d32; --op-green-dark: #1b5e20; --op-ink: #1f2a37; --op-muted: #5b6673; --op-line: #e4e8ec; --op-soft: #f6f8fa; color: var(--op-ink); }
      .op-page p { font-size: 16px; line-height: 1.6; margin: 0 0 12px; }
      .op-page h4 { font-size: 18px; line-height: 1.3; margin: 0 0 6px; color: var(--op-ink); }
      .op-h { font-size: 24px; margin: 0 0 10px; color: var(--op-accent); }
      .op-hero { margin: 18px 0 30px; padding: 34px 36px; border-radius: 10px; color: #1f1f1f;
         background: linear-gradient(135deg, #b0b0b0 0%, #dcdcdc 50%, #ffffff 100%); border: 1px solid #d0d0d0; box-shadow: 0 4px 14px rgba(0,0,0,.08); }
      .op-hero h2 { margin: 0 0 10px; font-size: 34px; line-height: 1.15; color: #1a1a1a; }
      .op-hero .op-lead { max-width: 760px; font-size: 18px; color: #333; margin-bottom: 20px; }
      .op-eyebrow { margin: 0 0 6px !important; font-size: 13px !important; letter-spacing: .12em; text-transform: uppercase; color: #555 !important; font-weight: bold; }
      .op-jump { display: flex; flex-wrap: wrap; gap: 10px; }
      .op-jump a { display: inline-block; padding: 8px 16px; border-radius: 999px; background: rgba(255,255,255,.75); border: 1px solid #9a9a9a; color: #1f1f1f; font-weight: bold; font-size: 15px; text-decoration: none; transition: background .15s; }
      .op-jump a:hover, .op-jump a:focus { background: #fff; border-color: #555; color: #000; text-decoration: none; }
      .op-section { margin: 0 0 30px; scroll-margin-top: 20px; }
      .op-intro { color: var(--op-muted); }
      .op-values { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
      .op-value { padding: 20px 18px; background: #fff; border: 1px solid var(--op-line); border-top: 4px solid var(--op-accent); border-radius: 8px; transition: transform .15s, box-shadow .15s; }
      .op-value:hover { transform: translateY(-3px); box-shadow: 0 8px 18px rgba(0,0,0,.08); }
      .op-value p { font-size: 15px; color: var(--op-muted); margin: 0; }
      .op-icon { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; margin-bottom: 10px; border-radius: 50%; background: #fdecea; color: var(--op-accent); font-size: 20px; flex-shrink: 0; }
      .op-card { padding: 26px 28px; background: #fff; border: 1px solid var(--op-line); border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.04); }
      .op-card-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
      .op-card-head .op-icon { margin: 0; }
      .op-card-head .op-h { margin: 0; }
      .op-label { margin: 6px 0 8px !important; font-size: 13px !important; letter-spacing: .08em; text-transform: uppercase; font-weight: bold; color: var(--op-muted); }
      .op-tags { list-style: none; margin: 0 0 18px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
      .op-tags li { padding: 5px 12px; border-radius: 999px; background: var(--op-soft); border: 1px solid var(--op-line); font-size: 14px; color: var(--op-ink); }
      .op-callout { position: relative; padding: 20px 22px; border-radius: 8px; background: #eef7ef; border-left: 5px solid var(--op-green); }
      .op-callout h4 { color: var(--op-green-dark); }
      .op-deadline { margin: 0 !important; padding: 10px 14px; background: #fff; border: 1px dashed var(--op-green); border-radius: 6px; font-size: 15px !important; }
      .op-deadline .fa { color: var(--op-green); margin-right: 4px; }
      .op-badge { display: inline-block; margin-bottom: 8px; padding: 3px 10px; border-radius: 999px; background: var(--op-green); color: #fff; font-size: 12px; font-weight: bold; letter-spacing: .04em; text-transform: uppercase; }
      .op-badge-soft { background: #e3eef9; color: #1f5f8b; }
      .op-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
      .op-position { display: flex; flex-direction: column; align-items: flex-start; padding: 20px 22px; border-radius: 8px; border: 1px solid #cfe5d1; background: #f7fbf7; }
      .op-position h4 { margin-bottom: 14px; }
      .op-position p:last-child { margin-bottom: 0; }
      .op-position-alt { border-color: #d6e4f2; background: #f6f9fd; }
      .op-btn { display: inline-block; margin-top: auto; padding: 9px 18px; border-radius: 6px; background: var(--op-green); color: #fff !important; font-weight: bold; font-size: 15px; text-decoration: none !important; transition: background .15s; }
      .op-btn:hover, .op-btn:focus { background: var(--op-green-dark); }
      .op-btn-lg { padding: 12px 24px; font-size: 17px; }
      .op-apply { padding: 26px 28px; border-radius: 10px; background: var(--op-soft); border: 1px solid var(--op-line); }
      .op-steps { list-style: none; margin: 6px 0 20px; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
      .op-steps li { display: flex; gap: 12px; align-items: flex-start; padding: 16px; background: #fff; border-radius: 8px; border: 1px solid var(--op-line); }
      .op-steps p { font-size: 15px; color: var(--op-muted); margin: 0; }
      .op-step-n { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--op-accent); color: #fff; font-weight: bold; flex-shrink: 0; }
      .op-cta { margin: 0 !important; text-align: center; }
      @media (max-width: 979px) { .op-values { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 767px) {
         .op-hero { padding: 24px 20px; } .op-hero h2 { font-size: 27px; } .op-hero .op-lead { font-size: 16px; }
         .op-values, .op-grid, .op-steps { grid-template-columns: 1fr; }
         .op-card, .op-apply { padding: 20px 18px; }
      }
   </style>
</head>
   
